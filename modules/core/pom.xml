<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.kniazkov</groupId>
        <artifactId>widgets-modules</artifactId>
        <version>0.2.1</version>
    </parent>
    <artifactId>widgets-core</artifactId>
    <name>Widgets Core</name>
    <description>Widget tree, models and browser resources for Widgets applications.</description>
    <dependencies>
        <dependency>
            <groupId>com.kniazkov</groupId>
            <artifactId>json</artifactId>
            <version>2.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.kniazkov</groupId>
            <artifactId>webserver</artifactId>
            <version>2.0.0</version>
        </dependency>
    </dependencies>
    <build>
        <sourceDirectory>${project.build.directory}/module-sources</sourceDirectory>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>../../src/main/html</directory>
            </resource>
            <resource>
                <directory>../../src/main/release</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>select-module-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.sourceDirectory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>../../src/main/java</directory>
                                    <excludes>
                                        <exclude>com/kniazkov/widgets/example/**</exclude>
                                        <exclude>com/kniazkov/widgets/db/**</exclude>
                                        <exclude>com/kniazkov/widgets/base/Server.java</exclude>
                                        <exclude>com/kniazkov/widgets/base/CreateClient.java</exclude>
                                        <exclude>com/kniazkov/widgets/base/HttpHandler.java</exclude>
                                        <exclude>com/kniazkov/widgets/base/StreamEndpoint.java</exclude>
                                        <exclude>com/kniazkov/widgets/base/StreamServer.java</exclude>
                                        <exclude>com/kniazkov/widgets/base/PushServer.java</exclude>
                                        <exclude>com/kniazkov/widgets/base/ProtocolSecurity.java</exclude>
                                        <exclude>com/kniazkov/widgets/base/RequestDiagnostics.java</exclude>
                                        <exclude>com/kniazkov/widgets/images/ImageLoader.java</exclude>
                                        <exclude>com/kniazkov/widgets/images/ImageProcessor.java</exclude>
                                        <exclude>com/kniazkov/widgets/images/ImageDecodeLimits.java</exclude>
                                        <exclude>com/kniazkov/widgets/images/ImageDimensions.java</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
